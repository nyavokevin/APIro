{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APIForge",
  "version": "0.1.0",
  "identifier": "com.apiforge.app",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "APIForge",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; script-src 'self' blob: 'unsafe-inline'; style-src 'self' 'unsafe-inline' blob: data:; img-src 'self' data: blob:; connect-src 'self' https: wss: ws: blob: data:; frame-src 'self' data: blob:; object-src 'none'; base-uri 'self'; media-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage", "rpm", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "active": false
    }
  }
}